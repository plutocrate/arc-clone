0:{"buildId":"","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"tv","children":[["$","main",null,{"className":"vhs pj","children":[["$","$L2",null,{}],["$","$L3",null,{"title":"Refresh","client":"Refresh","year":2026,"services":["Web\nDesign","Development"],"results":["CSSDA Special Kudos","CSSDA Best UI Design","CSSDA Best Innovation","CSSDA Best UX Design","Awwwards Honorable Mention"],"description":"Boosting Online Presence with a Bold Interactive One-Pager","summary":"Refresh\nneeded a site as strong as the photography, one that gets the work seen and brings in enquiries. I designed and built it image-first, on an SEO-ready foundation made to be found. It went on to win four CSSDA awards, including Best UI and Best UX.","url":"https://www.refresh.co.za/","slides":[{"kind":"image","src":"/media/refresh.jpg","width":1068,"height":646,"alt":"Refresh\nwebsite on a monitor"},{"kind":"video","src":"https://js6cl9vztfiln5zt.public.blob.vercel-storage.com/sanity/8e4d86c2e516177a39c35c48573a2872600f6cba.mp4","width":4,"height":3,"alt":"Refresh loading screen","still":{"src":"/media/refresh.jpg","width":3200,"height":2400}},{"kind":"video","src":"https://js6cl9vztfiln5zt.public.blob.vercel-storage.com/sanity/cf27583416587e82347c4c3a040bf07c1bf7c1a8.mp4","width":4,"height":3,"alt":"","still":{"src":"/media/refresh.jpg","width":3200,"height":2400}},{"kind":"video","src":"https://js6cl9vztfiln5zt.public.blob.vercel-storage.com/sanity/a6cafe8cd07505def709e4107bebf2668f69c9d0.mp4","width":4,"height":3,"alt":"","still":{"src":"/media/refresh.jpg","width":3200,"height":2400}},{"kind":"video","src":"https://js6cl9vztfiln5zt.public.blob.vercel-storage.com/sanity/4499754e9b6688e5656571ebb71ef82fc72a5715.mp4","width":4,"height":3,"alt":"","still":{"src":"/media/refresh.jpg","width":3200,"height":2400}},{"kind":"video","src":"https://js6cl9vztfiln5zt.public.blob.vercel-storage.com/sanity/e6a5a87192d252a7bd4747826436cc5e56b4e6a7.mp4","width":4,"height":3,"alt":"","still":{"src":"/media/refresh.jpg","width":3200,"height":2400}},{"kind":"video","src":"https://js6cl9vztfiln5zt.public.blob.vercel-storage.com/sanity/25c74977ffd50b07f3f109194a95769e1fd0ff37.mp4","width":4,"height":3,"alt":"","still":{"src":"/media/refresh.jpg","width":3200,"height":2400}},{"kind":"image","src":"/media/refresh.jpg","width":1600,"height":1200,"alt":""},{"kind":"image","src":"/media/refresh.jpg","width":1600,"height":1200,"alt":""}],"sections":[{"at":1,"key":"copy-1","label":"The\nbrief","lead":"A site as strong as the photography.","body":["Refresh' old site missed its search targets and hid the studio's other work. The brief was to keep its distinctive identity and make a site that's clear, made to be found, and a pleasure\nto look through.","I wrote it for three people: the brand's custodian who needs a safe pair of hands, someone building a personal brand, and the aspiring shooter who wants to learn."]},{"at":2,"key":"copy-3","label":"01 Â· First impression","lead":"Bold,\nbut out of the work's way.","body":["Refresh' red and type, plenty of room around the work, and motion that makes it feel alive without getting in the way. You choose to come in with sound or without."]},{"at":3,"key":"copy-5","label":"02 Â· The work","lead":"Three\nways to browse.","body":["The work can be seen as a slider, a grid or a list, each a click apart, with a fisheye lens and sound to turn on or off."]},{"at":4,"key":"copy-7","label":"03 Â· Projects","lead":"Stills and motion, each their own way.","body":["A\nproject's stills run edge to edge as you scroll, and its motion plays on a timeline, with the next project waiting at the end."]},{"at":6,"key":"copy-10","label":"04 Â· Hands-free","lead":"Step in front of the camera.","body":["Turn on gestures and the\ncamera follows your hands, all the way to taking your own portrait: a countdown, then a Refresh print to download."]},{"at":7,"key":"copy-12","label":"05 Â· The studio","lead":"Who they are, everywhere.","body":["The studio's pages set out who Refresh\nare, what they do and the brands they've worked with, and it all works as well on a phone."]},{"at":9,"key":"copy-15","label":"Outcome","lead":"Seen around the world.","body":["The site earned an Awwwards Honorable Mention and four CSSDA awards: Best\nUI, Best UX, Best Innovation and Special Kudos.","In its first five weeks it had 31,284 page views from 12,217 visitors, about 2.6 pages each. Over a third came from Awwwards, and people visited from India, the US, France, Brazil, Germany and beyond."]}],"next":{"slug":"depthfirst","title":"DepthFirst","discipline":"Web\nDesign â€¢ Web App","sleeve":"/media/depthfirst.jpg","photo":"/media/depthfirst.jpg"}}]]}],"$L4"]}],["$L5","$L6"],"$L7"]}],"isPartial":"$@8","staleTime":"$9","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$9","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$9","varyParams":"$e"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$9","varyParams":"$e"},{"rsc":"$L11","isPartial":"$@12","staleTime":"$9","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@13","rootVaryParams":null,"needsRuntimeRequest":"$@14"}
